<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIVINE Bot - Configuración de <%= guild.name %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #0f0f15;
      color: #ffffff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
    }
    .navbar {
      background-color: #1a1a24;
      border-bottom: 1px solid #2a2a3a;
    }
    .config-card {
      background-color: #1a1a24;
      border: 1px solid #2a2a3a;
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2rem;
    }
    .form-control, .form-select {
      background-color: #0f0f15;
      border: 1px solid #2a2a3a;
      color: #ffffff;
    }
    .form-control:focus, .form-select:focus {
      background-color: #0f0f15;
      border-color: #5865f2;
      color: #ffffff;
      box-shadow: none;
    }
    .form-check-input:checked {
      background-color: #5865f2;
      border-color: #5865f2;
    }
    .btn-save {
      background-color: #57f287;
      color: #000000;
      font-weight: 600;
      border-radius: 8px;
      padding: 10px 24px;
      border: none;
      transition: background-color 0.2s ease;
    }
    .btn-save:hover {
      background-color: #3ba55d;
      color: #ffffff;
    }
    .btn-back {
      background-color: #2b2d31;
      color: #ffffff;
      font-weight: 600;
      border-radius: 8px;
      text-decoration: none;
      padding: 8px 16px;
      display: inline-block;
      margin-bottom: 1.5rem;
    }
    .btn-back:hover {
      background-color: #35373c;
      color: #ffffff;
    }
    .user-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      margin-right: 10px;
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark px-4 py-3">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/">DIVINE Bot</a>
      <div class="d-flex align-items-center">
        <% if (user.avatar) { %>
          <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" class="user-avatar">
        <% } %>
        <span class="me-3 font-weight-bold"><%= user.username %></span>
        <a href="/logout" class="btn btn-outline-danger btn-sm">Cerrar Sesión</a>
      </div>
    </div>
  </nav>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="container my-5">
    <a href="/dashboard" class="btn-back">← Volver a Servidores</a>
    
    <div class="d-flex align-items-center mb-4">
      <% if (guild.icon) { %>
        <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128" alt="<%= guild.name %>" width="60" height="60" class="rounded-circle me-3">
      <% } %>
      <div>
        <h2 class="fw-bold mb-0"><%= guild.name %></h2>
        <p class="text-secondary mb-0">Configura las funciones del bot para este servidor.</p>
      </div>
    </div>

    <form action="/dashboard/<%= guild.id %>" method="POST">
      
      <!-- CONFIGURACIÓN ANTI-RAID -->
      <div class="config-card">
        <h4 class="fw-bold mb-3 text-warning">🛡️ Sistema Anti-Raid</h4>
        <div class="form-check form-switch mb-3">
         <input class="form-check-input" type="checkbox" id="antiraid" name="antiraid" <%= (typeof antiraid !== 'undefined' && antiraid) ? 'checked' : '' %>>
          <label class="form-check-label" for="antiraid">Activar protección Anti-Raid (Bloqueo de Spam y Links no autorizados)</label>
        </div>
      </div>

      <!-- CONFIGURACIÓN DE TICKETS -->
      <div class="config-card">
        <h4 class="fw-bold mb-3 text-info">🎟️ Configuración de Tickets</h4>
        
        <div class="mb-3">
          <label for="ticketCategory" class="form-label">Categoría para abrir Tickets:</label>
          <select class="form-select" id="ticketCategory" name="ticketCategory">
            <option value="">-- Sin categoría asignada --</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= ticketCategory === cat.id ? 'selected' : '' %>><%= cat.name %></option>
            <% }); %>
          </select>
          <div class="form-text text-secondary">Los canales de tickets creados se colocarán dentro de esta categoría.</div>
        </div>
      </div>

      <button type="submit" class="btn-save">Guardar Cambios</button>
    </form>
  </div>

</body>
</html>