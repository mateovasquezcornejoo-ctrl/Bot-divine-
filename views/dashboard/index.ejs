<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>✨ Select Server - DIVINE ✨</title>
  <style>
    body { font-family: Arial, sans-serif; background: #18181b; color: white; padding: 40px; }
    .grid { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 20px; }
    .card { background: #27272a; padding: 20px; border-radius: 8px; text-align: center; width: 200px; }
    .btn { display: inline-block; background: #22c55e; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; margin-top: 10px; }
    .header { display: flex; justify-content: space-between; align-items: center; }
  </style>
</head>
<body>
  <div class="header">
    <h1>👑 Your Servers</h1>
    <div>
      <span>Hello, <%= user.username %>! 👋</span> | <a href="/logout" style="color: #ef4444;">Logout</a>
    </div>
  </div>
  <p>Select a server to manage:</p>

  <div class="grid">
    <% guilds.forEach(guild => { %>
      <div class="card">
        <h3><%= guild.name %></h3>
        <a href="/dashboard/<%= guild.id %>" class="btn">⚙️ Configure</a>
      </div>
    <% }) %>
  </div>
</body>
</html>