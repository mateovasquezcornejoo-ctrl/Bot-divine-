<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIVINE Bot - Seleccionar Servidor</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #0f0f15;
      color: #ffffff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
    }
    .navbar {
      background-color: #1a1a24;
      border-bottom: 1px solid #2a2a3a;
    }
    .guild-card {
      background-color: #1a1a24;
      border: 1px solid #2a2a3a;
      border-radius: 12px;
      padding: 1.5rem;
      text-align: center;
      transition: transform 0.2s ease, border-color 0.2s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
    }
    .guild-card:hover {
      transform: translateY(-5px);
      border-color: #5865f2;
    }
    .guild-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 1rem;
      background-color: #2b2d31;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 1.5rem;
      color: #dbdee1;
    }
    .btn-config {
      background-color: #5865f2;
      color: white;
      font-weight: 600;
      border-radius: 8px;
      text-decoration: none;
      padding: 8px 16px;
      width: 100%;
      display: inline-block;
      transition: background-color 0.2s ease;
    }
    .btn-config:hover {
      background-color: #4752c4;
      color: white;
    }
    .user-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      margin-right: 10px;
    }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark px-4 py-3">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="/">DIVINE Bot</a>
      <div class="d-flex align-items-center">
        <% if (user.avatar) { %>
          <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" class="user-avatar">
        <% } %>
        <span class="me-3 font-weight-bold"><%= user.username %></span>
        <a href="/logout" class="btn btn-outline-danger btn-sm">Cerrar Sesión</a>
      </div>
    </div>
  </nav>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="container my-5">
    <h2 class="fw-bold mb-2">Selecciona un Servidor</h2>
    <p class="text-secondary mb-4">Solo se muestran los servidores donde tienes permisos de Administrador.</p>

    <div class="row g-4">
      <% if (guilds && guilds.length > 0) { %>
        <% guilds.forEach(guild => { %>
          <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="guild-card">
              <div>
                <% if (guild.icon) { %>
                  <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128" alt="<%= guild.name %>" class="guild-icon">
                <% } else { %>
                  <div class="guild-icon">
                    <%= guild.name.split(' ').map(w => w[0]).join('').substring(0, 3) %>
                  </div>
                <% } %>
                <h5 class="fw-bold mb-3 text-truncate" style="max-width: 200px;"><%= guild.name %></h5>
              </div>
              <a href="/dashboard/<%= guild.id %>" class="btn-config">Configurar</a>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12">
          <div class="alert alert-warning text-center" role="alert">
            No se encontraron servidores donde tengas permisos de Administrador.
          </div>
        </div>
      <% } %>
    </div>
  </div>

</body>
</html>