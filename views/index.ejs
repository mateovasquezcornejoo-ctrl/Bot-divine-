<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIVINE Bot - Panel de Control</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #0f0f15;
      color: #ffffff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .hero-card {
      background-color: #1a1a24;
      border: 1px solid #2a2a3a;
      border-radius: 16px;
      padding: 2.5rem;
      max-width: 500px;
      width: 90%;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      text-align: center;
    }
    .btn-discord {
      background-color: #5865f2;
      color: white;
      font-weight: 600;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-block;
      transition: background-color 0.2s ease, transform 0.1s ease;
      margin-top: 1.5rem;
    }
    .btn-discord:hover {
      background-color: #4752c4;
      color: white;
      transform: translateY(-2px);
    }
    .btn-dashboard {
      background-color: #57f287;
      color: #000000;
      font-weight: 600;
      padding: 12px 24px;
      border-radius: 8px;
      text-decoration: none;
      display: inline-block;
      transition: background-color 0.2s ease;
      margin-top: 1.5rem;
    }
    .btn-dashboard:hover {
      background-color: #3ba55d;
      color: #ffffff;
    }
    .avatar {
      border-radius: 50%;
      margin-bottom: 1rem;
      border: 3px solid #5865f2;
    }
  </style>
</head>
<body>

  <div class="hero-card">
    <h1 class="fw-bold mb-3">DIVINE Bot</h1>
    <p class="text-secondary">Panel de administración para configurar el sistema Anti-Raid y Tickets de tus servidores.</p>

    <% if (user) { %>
      <div>
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=128" alt="Avatar" class="avatar" width="80" height="80">
        <h3>¡Hola, <%= user.username %>!</h3>
        <a href="/dashboard" class="btn-dashboard">Ir al Dashboard</a>
        <br>
        <a href="/logout" class="text-danger d-inline-block mt-3 text-decoration-none">Cerrar sesión</a>
      </div>
    <% } else { %>
      <div>
        <a href="/login" class="btn-discord">Iniciar Sesión con Discord</a>
      </div>
    <% } %>
  </div>

</body>
</html>